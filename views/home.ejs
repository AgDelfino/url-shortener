<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Hello From The Server</h1>

    <h2>This are your shortened URLs:</h2>
    <ol>
        <% urls.forEach(url => { %>
         <li>
            <%= url.shortId %>
         </li>
        <% }); %>
    </ol>
</body>
</html>