<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 40px;
            background-color: #f4f4f4;
        }
        h1 {
            color: hsl(0, 0%, 20%);
        }
        #form form {
            display: flex;
            align-items: center;
            gap: 20px; 
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>URL Shortener</h1>
    <% if (locals.id) { %>
        <p>Your shortened URL is: http://localhost:8001/r/<strong><%= id %></strong></p>
    <% } %>
    <div id="form">
        <form method="POST" action="/url">
            <label>Enter your URL</label>
            <input type="text" placeholder="https://example.com" name="url" />
            <button type="submit">GENERATE</button>
        </form>
    </div>
    <% if (locals.urls) { %>
     <div>
        <h2>Recentrly Shortened URL's</h2>
        <table>
            <thead>
                    <th>So. N</th>
                    <th>Short ID</th>
                    <th>Redirect</th>
                    <th>Clicks</th>
            </thead>
            <tbody>
                    <% locals.urls.forEach((url, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                     <td><%= url.shortId %></td>
                     <td><%= url.redirectUrl %></td>
                     <td><%= url.visitHistory.length %></td>
                </tr>
                    <% }) %>
            </tbody>
        </table>
     </div>
    <% } %>
</body>
</html>